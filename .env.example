# Copy this file to .env and fill it in.

## Required - Discord channel webhook
## Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
CHANNEL_WEBHOOK=

## Optional - makes the bot appear online (bot token from the Discord developer portal)
BOT_TOKEN=

## Optional
# PING_ROLE_ID=123456789012345678
# BATCH_SIZE=5
# CHECK_INTERVAL_MS=30000
# WEBHOOK_USERNAME=Update Tracker
# DRY_RUN=0